---
import Head from "../shared/Head.astro";
import Header from "../shared/Header.astro";
import Footer from "../shared/Footer.astro";
import "../styles/tool-form.css";

const { title, activeTab } = Astro.props;
---

<html lang="en">
  <head>
    <Head title={title} />
  </head>
  <body>
    <Header />
    <main>
      <h1>Car Loan Calculator</h1>
      <p class="subtitle">Malaysian hire purchase (flat rate) calculator</p>

      <div class="tabs">
        <a
          href="/car/price/"
          class={`tab ${activeTab === "price" ? "active" : ""}`}
        >
          Price &rarr; Monthly
        </a>
        <a
          href="/car/monthly/"
          class={`tab ${activeTab === "monthly" ? "active" : ""}`}
        >
          Monthly &rarr; Price
        </a>
      </div>

      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    font-family:
      system-ui,
      -apple-system,
      sans-serif;
    background: #faf9f7;
    color: #1a1a1a;
    min-height: 100vh;
  }

  main {
    max-width: 560px;
    margin: 0 auto;
    padding: 5rem 1rem 2rem;
  }

  h1 {
    font-size: 2rem;
    font-weight: 400;
    line-height: 1.2;
    margin-bottom: 0.25rem;
  }

  .subtitle {
    font-size: 0.85rem;
    color: #555555;
    margin-bottom: 2rem;
  }

  .tabs {
    display: flex;
    gap: 0.25rem;
    margin-bottom: 1.5rem;
    background: #f0f0f0;
    border-radius: 6px;
    padding: 0.25rem;
  }

  .tab {
    flex: 1;
    padding: 8px 12px;
    border: none;
    background: transparent;
    border-radius: 4px;
    font-size: 0.85rem;
    font-family: inherit;
    cursor: pointer;
    color: #555555;
    text-decoration: none;
    text-align: center;
    transition:
      background 0.15s ease,
      color 0.15s ease;
    min-height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .tab.active {
    background: white;
    color: #1a1a1a;
    font-weight: 600;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.08);
  }

  .tab:hover:not(.active) {
    color: #333;
  }
</style>

<style is:global>
  .field input[type="number"] {
    width: 100%;
    box-sizing: border-box;
    padding: 10px 13px;
    border: 1px solid #e8e6e2;
    border-radius: 6px;
    font-size: 1.1rem;
    font-family: inherit;
  }
</style>
