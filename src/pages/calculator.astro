---
import Calculator from "../components/Calculator";
import Head from "../shared/Head.astro";
import Header from "../shared/Header.astro";
---

<html lang="en">
  <head>
    <Head title="Calculator" />
  </head>
  <body>
    <Header />
    <main>
      <h1>Calculator</h1>
      <p class="subtitle">Basic calculator with calculation history</p>

      <Calculator client:visible />
    </main>
  </body>
</html>

<style>
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    font-family:
      system-ui,
      -apple-system,
      sans-serif;
    background: #f5f5f5;
    color: #1a1a1a;
    min-height: 100vh;
  }

  main {
    max-width: 560px;
    margin: 0 auto;
    padding: 5rem 1rem 2rem;
  }

  h1 {
    font-size: 2rem;
    margin-bottom: 0.25rem;
  }

  .subtitle {
    color: #666;
    margin-bottom: 2rem;
  }
</style>

<style is:global>
  .calc-wrapper {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .calc {
    background: white;
    border-radius: 12px;
    padding: 1rem;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }

  .calc-display {
    background: #f8f7ff;
    border: 1px solid #e8e6f5;
    border-radius: 8px;
    padding: 0.75rem 1rem;
    margin-bottom: 0.75rem;
    min-height: 80px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-end;
    overflow: hidden;
  }

  .calc-expression {
    font-size: 0.85rem;
    color: #888;
    min-height: 1.2em;
    word-break: break-all;
    text-align: right;
    width: 100%;
  }

  .calc-value {
    font-size: 2rem;
    font-weight: 600;
    color: #1a1a1a;
    word-break: break-all;
    text-align: right;
    width: 100%;
    line-height: 1.2;
  }

  .calc-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.5rem;
  }

  .calc-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 3rem;
    border: 1px solid #e8e6e2;
    border-radius: 8px;
    background: white;
    font-size: 1.15rem;
    font-family: inherit;
    cursor: pointer;
    transition:
      background 0.1s ease,
      border-color 0.1s ease;
    color: #1a1a1a;
  }

  .calc-btn:hover {
    background: #f5f5f5;
    border-color: #d0cdc7;
  }

  .calc-btn:active {
    background: #eee;
  }

  .calc-btn.fn {
    background: #f8f7ff;
    color: #4f46e5;
    font-weight: 500;
    border-color: #e8e6f5;
  }

  .calc-btn.fn:hover {
    background: #eeeef9;
    border-color: #c7c5ef;
  }

  .calc-btn.op {
    background: #f8f7ff;
    color: #4f46e5;
    font-size: 1.3rem;
    font-weight: 500;
    border-color: #e8e6f5;
  }

  .calc-btn.op:hover {
    background: #eeeef9;
    border-color: #c7c5ef;
  }

  .calc-btn.op.active {
    background: #4f46e5;
    color: white;
    border-color: #4f46e5;
  }

  .calc-btn.wide {
    grid-column: span 2;
  }

  .calc-btn.equals {
    background: #4f46e5;
    color: white;
    font-weight: 600;
    border-color: #4f46e5;
  }

  .calc-btn.equals:hover {
    background: #4338ca;
    border-color: #4338ca;
  }

  .calc-history {
    background: white;
    border-radius: 12px;
    padding: 1rem;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }

  .history-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
  }

  .history-title {
    font-size: 0.95rem;
    font-weight: 600;
  }

  .clear-btn {
    padding: 0.3rem 0.75rem;
    background: none;
    color: #dc2626;
    border: 1px solid #fca5a5;
    border-radius: 6px;
    font-size: 0.75rem;
    font-family: inherit;
    cursor: pointer;
    transition:
      background 0.15s ease,
      color 0.15s ease;
  }

  .clear-btn:hover {
    background: #fef2f2;
  }

  .history-list {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    max-height: 240px;
    overflow-y: auto;
  }

  .history-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.5rem 0.65rem;
    background: #fafaf9;
    border: 1px solid #eee;
    border-radius: 6px;
    cursor: pointer;
    transition:
      background 0.1s ease,
      border-color 0.1s ease;
    text-align: left;
    font-family: inherit;
    font-size: 0.85rem;
    color: #555;
    width: 100%;
  }

  .history-item:hover {
    background: #f5f5f5;
    border-color: #ddd;
  }

  .history-expr {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .history-result {
    font-weight: 600;
    color: #4f46e5;
    margin-left: 0.5rem;
    white-space: nowrap;
  }
</style>
