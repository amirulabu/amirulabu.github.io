---
import ToolLayout from "../layouts/ToolLayout.astro";
import TmuxCheatsheet from "../components/TmuxCheatsheet";
---

<ToolLayout
  title="Tmux Cheatsheet"
  subtitle="Interactive quick reference for tmux shortcuts"
  maxWidth="700px"
>
  <TmuxCheatsheet client:load />
</ToolLayout>

<style is:global>
  .cheatsheet {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .search-input {
    width: 100%;
    padding: 10px 13px;
    border: 1px solid #e8e6e2;
    border-radius: 8px;
    font-size: 1rem;
    font-family: inherit;
    background: white;
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease;
  }

  .search-input:focus {
    outline: none;
    border-color: #3573c6;
    box-shadow: 0 0 0 2px rgba(53, 115, 198, 0.18);
  }

  .section-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .section-tab {
    padding: 0.35rem 0.7rem;
    border: 1px solid #e8e6e2;
    border-radius: 6px;
    background: white;
    font-size: 0.8rem;
    font-family: inherit;
    cursor: pointer;
    color: #555555;
    transition:
      background 0.15s ease,
      border-color 0.15s ease,
      color 0.15s ease;
  }

  .section-tab:hover {
    border-color: #d0cdc7;
    color: #1a1a1a;
  }

  .section-tab.active {
    background: #3573c6;
    border-color: #3573c6;
    color: white;
  }

  .section-tab.dimmed {
    opacity: 0.4;
  }

  .tab-count {
    display: inline-block;
    margin-left: 0.3rem;
    background: rgba(0, 0, 0, 0.08);
    border-radius: 4px;
    padding: 0 0.35rem;
    font-size: 0.7rem;
  }

  .section-tab.active .tab-count {
    background: rgba(255, 255, 255, 0.25);
  }

  .result-count {
    font-size: 0.8rem;
    color: #888888;
  }

  .section {
    background: white;
    border-radius: 8px;
    border: 1px solid #e8e6e2;
    overflow: hidden;
  }

  .section-title {
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #888888;
    padding: 0.75rem 1rem 0.5rem;
    background: #fafafa;
    border-bottom: 1px solid #e8e6e2;
  }

  .shortcut-list {
    display: flex;
    flex-direction: column;
  }

  .shortcut-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.6rem 1rem;
    transition: background 0.1s ease;
  }

  .shortcut-row:hover {
    background: #ebf2fa;
  }

  .shortcut-row + .shortcut-row {
    border-top: 1px solid #f0efed;
  }

  .shortcut-keys {
    flex-shrink: 0;
    min-width: 180px;
  }

  .keys {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 2px;
  }

  .keys kbd {
    display: inline-block;
    padding: 0.2rem 0.5rem;
    background: #f3f3f3;
    border: 1px solid #e8e6e2;
    border-bottom-width: 2px;
    border-radius: 4px;
    font-family: "SF Mono", "Fira Code", "Cascadia Code", monospace;
    font-size: 0.8rem;
    color: #333;
    white-space: nowrap;
  }

  .key-plus {
    color: #aaa;
    font-size: 0.75rem;
    margin: 0 1px;
  }

  .command {
    font-family: "SF Mono", "Fira Code", "Cascadia Code", monospace;
    font-size: 0.8rem;
    background: #1a1a2e;
    color: #7dd3fc;
    padding: 0.2rem 0.55rem;
    border-radius: 4px;
    white-space: nowrap;
  }

  .shortcut-desc {
    font-size: 0.85rem;
    color: #555555;
  }

  .no-results {
    text-align: center;
    padding: 2rem;
    color: #aaa;
    font-size: 0.9rem;
  }

  .prefix-note {
    font-size: 0.78rem;
    color: #999999;
    text-align: center;
    padding-top: 0.5rem;
  }

  .prefix-note kbd {
    display: inline-block;
    padding: 0.15rem 0.4rem;
    background: #f3f3f3;
    border: 1px solid #e8e6e2;
    border-bottom-width: 2px;
    border-radius: 4px;
    font-family: "SF Mono", "Fira Code", "Cascadia Code", monospace;
    font-size: 0.75rem;
    color: #333;
  }

  .prefix-note .key-plus {
    color: #aaa;
    font-size: 0.7rem;
    margin: 0 1px;
  }

  @media (max-width: 600px) {
    .shortcut-keys {
      min-width: 140px;
    }

    .shortcut-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.25rem;
    }
  }
</style>
