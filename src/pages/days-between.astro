---
import ToolLayout from "../layouts/ToolLayout.astro";
import DaysBetween from "../components/DaysBetween";
---

<ToolLayout
  title="Days Between Dates"
  subtitle="Calculate the number of days between two dates"
>
  <DaysBetween client:only="preact" />
</ToolLayout>

<style is:global>
  .date-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }

  .field input[type="date"] {
    width: 100%;
    box-sizing: border-box;
    padding: 10px 13px;
    border: 1px solid #e8e6e2;
    border-radius: 6px;
    font-size: 1.1rem;
    font-family: inherit;
  }

  .field input[type="date"]:focus {
    outline: none;
    border-color: #3573c6;
    box-shadow: 0 0 0 2px rgba(53, 115, 198, 0.18);
  }
</style>
