---
import ToolLayout from "../layouts/ToolLayout.astro";
import DateCalculator from "../components/DateCalculator";
---

<ToolLayout
  title="Date Calculator"
  subtitle="Add or subtract days, months, and years from a date"
>
  <DateCalculator client:only="preact" />
</ToolLayout>

<style is:global>
  .field input[type="date"],
  .field input[type="number"] {
    width: 100%;
    box-sizing: border-box;
    padding: 10px 13px;
    border: 1px solid #e8e6e2;
    border-radius: 6px;
    font-size: 1.1rem;
    font-family: inherit;
  }

  .field input[type="date"]:focus,
  .field input[type="number"]:focus {
    outline: none;
    border-color: #3573c6;
    box-shadow: 0 0 0 2px rgba(53, 115, 198, 0.18);
  }

  .mode-toggle {
    display: flex;
    gap: 0;
    margin-bottom: 1.25rem;
    border: 1px solid #e8e6e2;
    border-radius: 6px;
    overflow: hidden;
  }

  .mode-btn {
    flex: 1;
    padding: 0.6rem;
    border: none;
    background: white;
    font-size: 0.9rem;
    font-family: inherit;
    cursor: pointer;
    transition:
      background 0.15s ease,
      color 0.15s ease;
    color: #555555;
  }

  .mode-btn + .mode-btn {
    border-left: 1px solid #e8e6e2;
  }

  .mode-btn.active {
    background: #3573c6;
    color: white;
  }

  .mode-btn:hover:not(.active) {
    background: #ebf2fa;
  }

  .duration-fields {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .duration-field label {
    display: block;
    font-size: 0.8rem;
    color: #555555;
    margin-bottom: 0.3rem;
  }

  .duration-field input {
    width: 100%;
    box-sizing: border-box;
    padding: 10px 13px;
    border: 1px solid #e8e6e2;
    border-radius: 6px;
    font-size: 1.1rem;
    font-family: inherit;
  }

  .duration-field input:focus {
    outline: none;
    border-color: #3573c6;
    box-shadow: 0 0 0 2px rgba(53, 115, 198, 0.18);
  }

  .result-row.monthly .value {
    font-size: 1.1rem;
    color: #3573c6;
    text-align: right;
  }
</style>
