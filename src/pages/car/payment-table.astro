---
import ToolLayout from "../../layouts/ToolLayout.astro";
import CarPaymentTable from "../../components/CarPaymentTable";
---

<ToolLayout
  title="Car Monthly Payment Table"
  subtitle="Compare car prices and loan tenures at a glance. Hover or focus a payment to trace its price and loan period."
  maxWidth="1180px"
>
  <CarPaymentTable client:load />
</ToolLayout>

<style is:global>
  .payment-tool {
    margin-top: 1.5rem;
  }
  .toolbar {
    margin-bottom: 1rem;
    padding: 0 1.1rem;
    background: #fff;
    border: 1px solid #e8e6e2;
    border-radius: 8px;
  }
  .control-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1rem 0;
  }
  .price-control {
    border-top: 1px solid #f0efed;
  }
  .eyebrow {
    display: block;
    color: #1a1a1a;
    font-size: 0.85rem;
    font-weight: 600;
  }
  .rate-note {
    color: #888;
    font-size: 0.78rem;
    margin-top: 0.1rem;
  }
  .stepper {
    display: grid;
    grid-template-columns: 44px 92px 44px;
    align-items: stretch;
    border: 1px solid #d0cdc7;
    border-radius: 8px;
    overflow: hidden;
    background: #fff;
  }
  .stepper button {
    min-height: 44px;
    border: 0;
    background: #fff;
    color: #3573c6;
    font-size: 1.25rem;
    cursor: pointer;
    transition:
      background-color 0.15s ease,
      color 0.15s ease;
  }
  .stepper button:first-child {
    border-right: 1px solid #e8e6e2;
  }
  .stepper button:last-child {
    border-left: 1px solid #e8e6e2;
  }
  .stepper button:hover {
    background: #ebf2fa;
    color: #2960ad;
  }
  .stepper button:focus-visible,
  td:focus-visible {
    outline: 2px solid #3573c6;
    outline-offset: -2px;
  }
  .stepper output {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 2px;
    padding-top: 8px;
    color: #1a1a1a;
  }
  .stepper output strong {
    font-size: 1.1rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .stepper output span {
    color: #555;
    font-size: 0.75rem;
  }
  .range-selects {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }
  .range-selects > span {
    color: #888;
    font-size: 0.75rem;
  }
  .range-selects select,
  .single-select select {
    min-height: 44px;
    padding: 0 2rem 0 0.75rem;
    border: 1px solid #d0cdc7;
    border-radius: 6px;
    background: #fff;
    color: #1a1a1a;
    font: inherit;
    cursor: pointer;
  }
  .single-select select {
    min-width: 112px;
  }
  .range-selects select:focus-visible,
  .single-select select:focus-visible {
    outline: 2px solid rgba(53, 115, 198, 0.35);
    outline-offset: 2px;
    border-color: #3573c6;
  }
  .table-frame {
    overflow: hidden;
    border: 1px solid #e8e6e2;
    border-radius: 8px;
    background: #fff;
  }
  .table-scroll {
    overflow-x: auto;
    scrollbar-color: #d0cdc7 #faf9f7;
  }
  table {
    width: max-content;
    min-width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    font-size: 0.9rem;
    font-variant-numeric: tabular-nums;
  }
  th,
  td {
    height: 54px;
    min-width: 90px;
    padding: 0.65rem 0.75rem;
    text-align: right;
    white-space: nowrap;
    border-right: 1px solid #f0efed;
    border-bottom: 1px solid #f0efed;
  }
  thead th {
    position: sticky;
    top: 0;
    z-index: 2;
    background: #faf9f7;
    color: #555;
    font-size: 0.72rem;
    font-weight: 600;
  }
  tbody th {
    position: sticky;
    left: 0;
    z-index: 1;
    min-width: 100px;
    background: #faf9f7;
    color: #555;
    text-align: left;
    font-weight: 400;
  }
  tbody th strong {
    color: #1a1a1a;
    font-size: 0.92rem;
  }
  .corner {
    left: 0;
    z-index: 3;
    min-width: 100px;
    text-align: left;
  }
  .corner span {
    display: block;
  }
  .corner span:first-child {
    color: #8b6d4f;
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  td {
    color: #1a1a1a;
    cursor: crosshair;
    font-size: 0.92rem;
    font-weight: 500;
    transition:
      background-color 0.12s ease,
      color 0.12s ease;
  }
  td span {
    margin-right: 3px;
    color: #999;
    font-size: 0.65rem;
  }
  tr:last-child th,
  tr:last-child td {
    border-bottom: 0;
  }
  th:last-child,
  td:last-child {
    border-right: 0;
  }
  .axis-active {
    background: #ebf2fa !important;
    color: #2960ad !important;
  }
  td.cell-active {
    background: #3573c6;
    color: #fff;
    font-weight: 600;
  }
  td.cell-active span {
    color: rgba(255, 255, 255, 0.72);
  }
  .legend {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.75rem;
    color: #555;
    font-size: 0.75rem;
  }
  .legend span:first-child {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .legend i {
    width: 9px;
    height: 9px;
    background: #3573c6;
    border-radius: 2px;
  }
  .disclaimer {
    max-width: 70ch;
    margin-top: 1.5rem;
    color: #888;
    font-size: 0.72rem;
    line-height: 1.6;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  @media (max-width: 600px) {
    .control-row {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.75rem;
    }
    .range-selects {
      width: 100%;
    }
    .range-selects select {
      flex: 1;
      min-width: 0;
    }
    .stepper {
      width: 100%;
      grid-template-columns: 44px 1fr 44px;
    }
    .legend {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.35rem;
    }
    th,
    td {
      min-width: 84px;
    }
  }
</style>
