---
import Head from "../shared/Head.astro";
import Header from "../shared/Header.astro";
import Footer from "../shared/Footer.astro";
---

<html lang="en">
  <head>
    <Head title="random">
      <link rel="preconnect" href="https://fonts.googleapis.com" />
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
      <link
        href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;1,6..72,400&family=Source+Code+Pro:wght@400;500&display=swap"
        rel="stylesheet"
      />
    </Head>
  </head>
  <body>
    <Header />
    <main>
      <header class="hero">
        <div class="hero-ambient" aria-hidden="true"></div>
        <div class="title-row">
          <svg
            class="favicon"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 128 128"
            aria-hidden="true"
          >
            <path d="M44 16h40v4H44z" fill="#3573c6"></path>
            <path
              d="M48 20v30l-20 50a8 8 0 0 0 7.4 11h57.2a8 8 0 0 0 7.4-11L80 50V20"
              fill="none"
              stroke="#3573c6"
              stroke-width="5"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
            <path
              d="M34.8 97a8 8 0 0 0 7.4 11h43.6a8 8 0 0 0 7.4-11L76 60H52L34.8 97Z"
              fill="#8bb5e8"
              opacity="0.5"></path>
            <circle cx="56" cy="82" r="5" fill="#a8cbf0" opacity="0.8"></circle>
            <circle cx="72" cy="74" r="3.5" fill="#a8cbf0" opacity="0.7"
            ></circle>
            <circle cx="64" cy="90" r="4" fill="#c5dbf5" opacity="0.6"></circle>
            <circle cx="60" cy="64" r="2.5" fill="#a8cbf0" opacity="0.5"
            ></circle>
            <circle cx="70" cy="56" r="2" fill="#c5dbf5" opacity="0.4"></circle>
            <line
              x1="48"
              y1="20"
              x2="48"
              y2="50"
              stroke="#3573c6"
              stroke-width="5"
              stroke-linecap="round"></line>
            <line
              x1="80"
              y1="20"
              x2="80"
              y2="50"
              stroke="#3573c6"
              stroke-width="5"
              stroke-linecap="round"></line>
          </svg>
          <h1 class="title">random</h1>
        </div>
        <p class="tagline">
          Experiments, demos, and things <span class="slashed">I</span><span
            class="ai">A.I.</span
          > build.
        </p>
        <p class="brand-statement">
          Everyday tools for everyday decisions. Quick, clear, yours.
        </p>
      </header>

      <section class="tool-index">
        <!-- Drive -->
        <div class="category">
          <h2 class="category-label">
            <span class="label-dot" aria-hidden="true"></span>
            Drive
          </h2>
          <div class="card-grid">
            <a href="/car/price/" class="page-card">
              <h3 class="card-title">
                <svg
                  class="card-icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  ><path
                    d="M5 17h2m10 0h2M2 9l2-4h16l2 4M2 9h20v7a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V9z"
                  ></path><circle cx="7" cy="17" r="2"></circle><circle
                    cx="17"
                    cy="17"
                    r="2"></circle></svg
                >
                Car Loan: Price to Monthly
              </h3>
              <p class="card-desc">
                Enter a car price and calculate monthly hire purchase payments
                with adjustable interest, tenure, and down payment.
              </p>
              <span class="card-arrow" aria-hidden="true">&rarr;</span>
            </a>

            <a href="/car/monthly/" class="page-card">
              <h3 class="card-title">
                <svg
                  class="card-icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  ><line x1="12" y1="1" x2="12" y2="23"></line><path
                    d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"
                  ></path></svg
                >
                Car Loan: Monthly to Price
              </h3>
              <p class="card-desc">
                Enter your monthly budget and find out what car price you can
                afford with Malaysian hire purchase rates.
              </p>
              <span class="card-arrow" aria-hidden="true">&rarr;</span>
            </a>

            <a href="/ev-charging/cost/" class="page-card">
              <h3 class="card-title">
                <svg
                  class="card-icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  ><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"
                  ></polygon></svg
                >
                EV Charging Cost &amp; Time
              </h3>
              <p class="card-desc">
                Estimate EV charging cost and time in Malaysia — compare
                providers, charger types, and see how long a charge takes.
              </p>
              <span class="card-arrow" aria-hidden="true">&rarr;</span>
            </a>

            <a href="/fuel-comparison/" class="page-card">
              <h3 class="card-title">
                <svg
                  class="card-icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  ><path
                    d="M12 2v20M2 12h20M12 2a10 10 0 0 1 10 10M12 2a10 10 0 0 0-10 10"
                  ></path></svg
                >
                Fuel Cost Comparison
              </h3>
              <p class="card-desc">
                Compare fuel costs between two cars with different efficiency —
                km/L or L/100km, with Malaysian fuel price presets.
              </p>
              <span class="card-arrow" aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </div>

        <!-- Calculate -->
        <div class="category">
          <h2 class="category-label">
            <span class="label-dot" aria-hidden="true"></span>
            Calculate
          </h2>
          <div class="card-grid">
            <a href="/age-calculator/" class="page-card">
              <h3 class="card-title">
                <svg
                  class="card-icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  ><rect x="3" y="4" width="18" height="18" rx="2" ry="2"
                  ></rect><line x1="16" y1="2" x2="16" y2="6"></line><line
                    x1="8"
                    y1="2"
                    x2="8"
                    y2="6"></line><line x1="3" y1="10" x2="21" y2="10"
                  ></line></svg
                >
                Age Calculator
              </h3>
              <p class="card-desc">
                Calculate age from birth year — save and track multiple entries
                locally in your browser.
              </p>
              <span class="card-arrow" aria-hidden="true">&rarr;</span>
            </a>

            <a href="/date-calculator/" class="page-card">
              <h3 class="card-title">
                <svg
                  class="card-icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  ><rect x="3" y="4" width="18" height="18" rx="2" ry="2"
                  ></rect><line x1="16" y1="2" x2="16" y2="6"></line><line
                    x1="8"
                    y1="2"
                    x2="8"
                    y2="6"></line><line x1="3" y1="10" x2="21" y2="10"
                  ></line><line x1="10" y1="14" x2="14" y2="14"></line><line
                    x1="12"
                    y1="12"
                    x2="12"
                    y2="16"></line></svg
                >
                Date Calculator
              </h3>
              <p class="card-desc">
                Add or subtract days, months, and years from a date using the
                Temporal API.
              </p>
              <span class="card-arrow" aria-hidden="true">&rarr;</span>
            </a>

            <a href="/days-between/" class="page-card">
              <h3 class="card-title">
                <svg
                  class="card-icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  ><circle cx="12" cy="12" r="10"></circle><polyline
                    points="12 6 12 12 16 14"></polyline></svg
                >
                Days Between Dates
              </h3>
              <p class="card-desc">
                Calculate the number of days, weeks, months, and years between
                two dates.
              </p>
              <span class="card-arrow" aria-hidden="true">&rarr;</span>
            </a>

            <a href="/calculator/" class="page-card">
              <h3 class="card-title">
                <svg
                  class="card-icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  ><rect x="4" y="2" width="16" height="20" rx="2"></rect><line
                    x1="8"
                    y1="6"
                    x2="16"
                    y2="6"></line><line x1="8" y1="10" x2="10" y2="10"
                  ></line><line x1="12" y1="10" x2="14" y2="10"></line><line
                    x1="16"
                    y1="10"
                    x2="16"
                    y2="10"></line><line x1="8" y1="14" x2="10" y2="14"
                  ></line><line x1="12" y1="14" x2="14" y2="14"></line><line
                    x1="8"
                    y1="18"
                    x2="10"
                    y2="18"></line><line x1="12" y1="18" x2="16" y2="18"
                  ></line></svg
                >
                Calculator
              </h3>
              <p class="card-desc">
                Basic calculator with arithmetic operations and calculation
                history saved in your browser.
              </p>
              <span class="card-arrow" aria-hidden="true">&rarr;</span>
            </a>

            <a href="/budget/" class="page-card">
              <h3 class="card-title">
                <svg
                  class="card-icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  ><line x1="12" y1="1" x2="12" y2="23"></line><path
                    d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"
                  ></path></svg
                >
                Budget Calculator
              </h3>
              <p class="card-desc">
                Track your income and expenses to see how much is left over each
                month.
              </p>
              <span class="card-arrow" aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </div>

        <!-- Explore -->
        <div class="category">
          <h2 class="category-label">
            <span class="label-dot" aria-hidden="true"></span>
            Explore
          </h2>
          <div class="card-grid">
            <a href="/test-preact/" class="page-card">
              <h3 class="card-title">
                <svg
                  class="card-icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  ><polyline points="16 18 22 12 16 6"></polyline><polyline
                    points="8 6 2 12 8 18"></polyline></svg
                >
                Preact Demo
              </h3>
              <p class="card-desc">
                Counter, multilingual greeting, and todo list — interactive
                Preact components in Astro.
              </p>
              <span class="card-arrow" aria-hidden="true">&rarr;</span>
            </a>

            <a href="/tmux/" class="page-card">
              <h3 class="card-title">
                <svg
                  class="card-icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  ><rect x="2" y="3" width="20" height="18" rx="2"></rect><line
                    x1="2"
                    y1="9"
                    x2="22"
                    y2="9"></line><line x1="12" y1="9" x2="12" y2="21"
                  ></line></svg
                >
                Tmux Cheatsheet
              </h3>
              <p class="card-desc">
                Interactive quick reference for tmux shortcuts — search, filter
                by category, and find commands fast.
              </p>
              <span class="card-arrow" aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>

<style>
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    background: #faf9f7;
    color: #1a1a1a;
  }

  body {
    font-family:
      system-ui,
      -apple-system,
      sans-serif;
    min-height: 100vh;
  }

  main {
    max-width: 800px;
    margin: 0 auto;
    padding: 5rem 2rem 2rem;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  /* ─── Hero ─── */

  .hero {
    position: relative;
    margin-bottom: 3rem;
    padding-top: 1rem;
  }

  .hero-ambient {
    position: absolute;
    top: -5rem;
    left: 50%;
    transform: translateX(-50%);
    width: clamp(400px, 80vw, 700px);
    height: clamp(400px, 80vw, 700px);
    border-radius: 50%;
    background: radial-gradient(
      circle at 40% 40%,
      rgba(139, 109, 79, 0.035) 0%,
      rgba(53, 115, 198, 0.025) 35%,
      transparent 65%
    );
    pointer-events: none;
    z-index: 0;
  }

  .title-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    position: relative;
    z-index: 1;
  }

  .favicon {
    width: clamp(2.4rem, 6vw, 3.2rem);
    height: clamp(2.4rem, 6vw, 3.2rem);
    flex-shrink: 0;
  }

  .title {
    font-family: "Newsreader", Georgia, serif;
    font-weight: 400;
    font-size: clamp(2.4rem, 7vw, 3.6rem);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .tagline {
    position: relative;
    z-index: 1;
    font-size: 0.95rem;
    line-height: 1.6;
    color: #555;
    margin-top: 0.75rem;
    max-width: 42ch;
  }

  .slashed {
    text-decoration: line-through;
    opacity: 0.5;
  }

  .ai {
    color: #3573c6;
    font-family: "Source Code Pro", monospace;
    font-weight: 500;
    margin-left: 0.2em;
  }

  .brand-statement {
    position: relative;
    z-index: 1;
    font-size: 0.82rem;
    line-height: 1.5;
    color: #888;
    margin-top: 0.4rem;
    max-width: 45ch;
  }

  /* ─── Tool Index ─── */

  .tool-index {
    flex: 1;
  }

  .category {
    margin-bottom: 2.5rem;
  }

  .category:last-child {
    margin-bottom: 0;
  }

  .category-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family:
      system-ui,
      -apple-system,
      sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    color: #8b6d4f;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    margin-bottom: 0.75rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid #f0efed;
  }

  .label-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #8b6d4f;
    flex-shrink: 0;
  }

  /* ─── Card Grid ─── */

  .card-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.6rem;
  }

  .page-card {
    display: block;
    padding: 1rem;
    background: #fff;
    border: 1px solid #e8e6e2;
    border-radius: 8px;
    text-decoration: none;
    color: inherit;
    position: relative;
    transition:
      border-color 0.25s ease,
      box-shadow 0.25s ease,
      transform 0.25s ease;
  }

  .page-card:hover {
    border-color: #d0cdc7;
    box-shadow: 0 3px 14px rgba(0, 0, 0, 0.06);
    transform: translateY(-1px);
  }

  .card-title {
    font-family: "Newsreader", Georgia, serif;
    font-size: 1rem;
    font-weight: 400;
    margin-bottom: 0.25rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .card-icon {
    width: 1em;
    height: 1em;
    flex-shrink: 0;
    color: #8b6d4f;
  }

  .card-desc {
    font-size: 0.78rem;
    color: #888;
    line-height: 1.6;
  }

  .card-arrow {
    position: absolute;
    top: 1rem;
    right: 1rem;
    color: #8b6d4f;
    font-size: 1.1rem;
    opacity: 0;
    transform: translateX(-4px);
    transition:
      opacity 0.25s ease,
      transform 0.25s ease;
  }

  .page-card:hover .card-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  /* ─── Entrance Motion ─── */

  @media (prefers-reduced-motion: no-preference) {
    @keyframes fade-up {
      from {
        opacity: 0;
        transform: translateY(10px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .page-card {
      animation: fade-up 0.5s cubic-bezier(0.25, 1, 0.5, 1) both;
    }

    /* Drive: 4 cards */
    .category:nth-of-type(1) .page-card:nth-child(1) {
      animation-delay: 0.1s;
    }
    .category:nth-of-type(1) .page-card:nth-child(2) {
      animation-delay: 0.16s;
    }
    .category:nth-of-type(1) .page-card:nth-child(3) {
      animation-delay: 0.22s;
    }
    .category:nth-of-type(1) .page-card:nth-child(4) {
      animation-delay: 0.28s;
    }

    /* Calculate: 5 cards */
    .category:nth-of-type(2) .page-card:nth-child(1) {
      animation-delay: 0.36s;
    }
    .category:nth-of-type(2) .page-card:nth-child(2) {
      animation-delay: 0.42s;
    }
    .category:nth-of-type(2) .page-card:nth-child(3) {
      animation-delay: 0.48s;
    }
    .category:nth-of-type(2) .page-card:nth-child(4) {
      animation-delay: 0.54s;
    }
    .category:nth-of-type(2) .page-card:nth-child(5) {
      animation-delay: 0.6s;
    }

    /* Explore: 2 cards */
    .category:nth-of-type(3) .page-card:nth-child(1) {
      animation-delay: 0.68s;
    }
    .category:nth-of-type(3) .page-card:nth-child(2) {
      animation-delay: 0.74s;
    }
  }

  /* ─── Mobile ─── */

  @media (max-width: 600px) {
    main {
      padding: 5rem 1.25rem 2rem;
    }

    .card-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
